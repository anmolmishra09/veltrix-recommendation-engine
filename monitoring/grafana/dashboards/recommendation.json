{
  "dashboard": {
    "id": null,
    "title": "Recommendation System Overview",
    "timezone": "browser",
    "browser"",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "type": "graph",
        "title": "API Request Rate",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "API Request Duration",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Cache Hit Rate",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "redis_cache_hits_total / (redis_cache_hits_total + redis_cache_misses_total) * 100",
            "legendFormat": "Cache Hit Rate (%)",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Kafka Consumer Lag",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "kafka_consumergroup_lag",
            "legendFormat": "{{topic}} - {{consumergroup}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Model Prediction Latency",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(model_prediction_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "95th percentile",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Recommendation CTR",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "recommendation_clicks_total / recommendation_impressions_total * 100",
            "legendFormat": "CTR (%)",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "Deployment",
          "type": "dashboard",
          "enable": true,
          "iconColor": "rgba(0, 211, 255, 0.7)",
          "enableEdit": true
        }
      ]
    }
  },
  "overwrite": true
}