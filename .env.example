# Environment
ENVIRONMENT=development
DEBUG=false

# Application
APP_NAME=Recommendation API
APP_VERSION=0.1.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recommendation_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_GROUP_ID=recommendation-platform
KAFKA_AUTO_OFFSET_RESET=earliest

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=./mlruns
MLFLOW_EXPERIMENT_NAME=recommendation-platform

# Feature Store Configuration
FEAST_REPO_PATH=/feast/feast_repository
FEAST_TENANT=recommendation-platform

# S3/MinIO Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=mlflow
S3_SECURE=false

# Monitoring Configuration
ENABLE_TELEMETRY=true
PROMETHEUS_PORT=9090
METRICS_NAMESPACE=recommendation_platform
LOG_LEVEL=INFO
TRACING_ENDPOINT=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=1
API_CORS_ORIGINS=*
API_TITLE=Recommendation API
API_DESCRIPTION=API for the recommendation platform
API_VERSION=0.1.0

# Model Configuration
MODEL_EMBEDDING_DIM=64
MODEL_BATCH_SIZE=256
MODEL_LEARNING_RATE=0.001
MODEL_EPOCHS=10
MODEL_VALIDATION_SPLIT=0.2
MODEL_SEED=42

# Recommendation Configuration
REC_DEFAULT_K=10
REC_MAX_K=100
REC_CANDIDATE_LIMIT_PER_SOURCE=1000
REC_HYBRID_WEIGHTS={"collaborative": 0.35, "content": 0.25, "popularity": 0.15, "embedding": 0.25}
REC_RANKING_MODEL_TYPE=xgboost
REC_COLD_START_ENABLED=true

# Security
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30